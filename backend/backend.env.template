# LiteRetail server settings - written by the installer (literetailer-backend setup).
# Location: C:\ProgramData\LiteRetailer\backend.env. Restart the "LiteRetail Server" service after editing.

FLASK_CONFIG=production

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=

# Secrets: generated once per installation, kept on upgrade
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_HOURS=12

# Allowed origins for the app ("*" is fine on a closed store LAN)
CORS_ORIGINS=*

LOG_LEVEL=INFO
LOG_FILE=

# Backups (pg_dump files) and supplier document uploads
BACKUP_DIR=
UPLOAD_DIR=
# PostgreSQL bin folder with pg_dump / pg_restore
PGBIN=

# --- S3 cloud backup (leave blank to disable cloud upload) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_S3_PREFIX=backups/

# --- Backup scheduler (cron: minute hour dom month dow; default = 22:00 daily) ---
BACKUP_CRON_SCHEDULE=0 22 * * *
# Backups older than this many days are deleted (local folder and VPS)
BACKUP_RETENTION_DAYS=30
# If the PC was off at the daily time: back up soon after it is switched on when the last backup is
# older than this many hours (0 = off)
BACKUP_CATCHUP_HOURS=24

# --- VPS / SFTP backup upload: every automatic backup is copied to this server ---
# Username / password come from backend.secrets.env at build time (not in git).
VPS_HOST=187.127.145.63
VPS_PORT=22
VPS_USERNAME=
VPS_PASSWORD=
VPS_SSH_KEY_PATH=
VPS_BACKUP_PATH=/pos/

# --- PostgreSQL replication monitoring (leave blank if no replica) ---
PG_REPLICA_HOST=

# Server (Waitress); counter PCs connect to http://<this PC's IP>:PORT/api/v1
HOST=0.0.0.0
PORT=5000

# --- Razorpay, Paytm and WhatsApp ---
# The admin enters these in the app (Admin -> Settings -> Integrations), which wins over the values below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_POS_BASE_URL=https://demo.ezetap.com/api/3.0/p2padapter
RAZORPAY_POS_USERNAME=
RAZORPAY_POS_APP_KEY=
RAZORPAY_MOCK=0
UPI_QR_EXPIRY_SECONDS=300

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=daily_collection
WHATSAPP_EBILL_TEMPLATE_NAME=ebill
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_MOCK=0
