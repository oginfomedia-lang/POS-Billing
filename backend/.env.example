# Backend settings. Copy this file to backend/.env and change the values.
# Never commit backend/.env.

FLASK_CONFIG=development

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://pos_app:change_me@localhost:5432/pos_db
TEST_DATABASE_URL=postgresql+psycopg://pos_app:change_me@localhost:5432/pos_test

# Secrets: use long random values in production
SECRET_KEY=ZkXdMc5XLTuT4Grv6O2hb6DPGMP9Oc27xF0JdTjQYReYq_nYCFp73X31M9ZxzWpFnAJCXKEyeabkyOaO0Uv97Q
JWT_SECRET_KEY=Ui9Qs0Piea-bdQXx_tlI312ChjLrPb-PhJsu15BYV2CDur8dALIET0roUigm5dwCPhgo5e_RFcz205FYw97J8Q
JWT_ACCESS_TOKEN_HOURS=12

# Allowed origins for the POS app ("*" is fine on a closed store LAN)
CORS_ORIGINS=*

LOG_LEVEL=INFO
# Optional: write logs to a rotating file as well as the console
LOG_FILE=

# Backup settings
# Directory where pg_dump files are stored (default: <project_root>/backups/daily)
BACKUP_DIR=
# VPS only: folder client shops upload their backups to (e.g. /backups/pos), so they can be downloaded and restored
CLIENT_BACKUP_DIR=
# Full path to the PostgreSQL bin directory, e.g. C:\Program Files\PostgreSQL\16\bin
# Leave empty when pg_dump / pg_restore are already on PATH
PGBIN=

# --- S3 cloud backup (leave blank to disable cloud upload) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=my-pos-backups
AWS_S3_REGION=ap-south-1
AWS_S3_PREFIX=backups/

# --- Backup scheduler (cron: minute hour dom month dow; default = 22:00 daily) ---
BACKUP_CRON_SCHEDULE=0 22 * * *

# --- PostgreSQL replication monitoring (leave blank if no replica) ---
PG_REPLICA_HOST=

# Production server (Waitress)
HOST=0.0.0.0
PORT=5000

# --- Razorpay, Paytm and WhatsApp ---
# Optional: the admin normally enters these in the app (Admin → Settings → Integrations), which wins
# over the values below. Leave them blank for a new client.

# --- Razorpay (card + UPI) ---
# API keys: Razorpay Dashboard -> Account & Settings -> API Keys (rzp_test_... for testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay POS (card machine) credentials, given by Razorpay POS onboarding
RAZORPAY_POS_BASE_URL=https://demo.ezetap.com/api/3.0/p2padapter
RAZORPAY_POS_USERNAME=
RAZORPAY_POS_APP_KEY=
# 1 = fake gateway for development (no real money, no real machine; "paid" after ~6 s). Use 0 in production.
RAZORPAY_MOCK=1
# A UPI QR closes itself after this many seconds (Razorpay allows 120-7200)
UPI_QR_EXPIRY_SECONDS=300

# --- WhatsApp daily collection summary (Meta WhatsApp Business Cloud API) ---
# Meta Business -> WhatsApp -> API Setup: a permanent System User token and the sender's Phone Number ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved Utility template with 6 body variables:
#   Daily collection for {{1}} on {{2}}. {{3}} Total: {{4}}, Returns: {{5}}, Net: {{6}}.
WHATSAPP_TEMPLATE_NAME=daily_collection
# E-bill to the customer: approved Utility template with a DOCUMENT header (the PDF bill) and 4 body variables:
#   Thank you for shopping at {{1}}. Your bill {{2}} dated {{3}} for {{4}} is attached.
WHATSAPP_EBILL_TEMPLATE_NAME=ebill
WHATSAPP_TEMPLATE_LANG=en
# 1 = don't send, only write the message to the log (development); e-bill PDFs go to logs/ebills/. Use 0 in production.
WHATSAPP_MOCK=1
